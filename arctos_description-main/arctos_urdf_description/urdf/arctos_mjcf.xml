  <worldbody>
    <light pos="0 0 2" dir="0 0 -1"/>

    <!-- ══ PEANA DEL BRAZO ══════════════════════════════════════════════════════
         El brazo NO se ha movido: su base sigue en z = 0 (igual que antes). Lo que
         baja es el SUELO, ALTURA_PEANA = 0.70 m, y en el hueco va la peana.
         Así todo lo que usa coordenadas del mundo (taladro [4]/[5], mesa [3],
         PALMA_Z_MIN, CODO_Z_MIN, ARM_Z_MINIMA, techo automático...) sigue igual.
         El suelo y la peana NO chocan con nada (contype/conaffinity = 0), igual
         que el suelo de antes: son solo decorado.
         Para cambiar la altura de la peana, cambia las z marcadas con [H]
         (H = 0.70) y las patas de mesa_trabajo.xml si H pasa de ~1 m. -->
    <geom name="floor" type="plane" pos="0 0 -0.70" size="2 2 0.1" material="suelo_elecnor_material"/>  <!-- [H] -->

    <!-- ══ DECORADO CORPORATIVO: geoms estáticos, solo visuales (contype/conaffinity = 0) ══ -->
    <!-- Pared de fondo blanca: ahora baja hasta el nuevo suelo (de z = -0.70 a 1.35) -->
    <geom name="deco_pared" type="box" pos="0 1.8 0.325" size="1.8 0.01 1.025"
          material="panel_blanco" contype="0" conaffinity="0"/>                                <!-- [H] -->
    <!-- Franja naranja inferior, apoyada en el suelo -->
    <geom name="deco_franja" type="box" pos="0 1.785 -0.64" size="1.8 0.008 0.06"
          material="naranja_personalizado" contype="0" conaffinity="0"/>                       <!-- [H] -->
    <!-- Logo Elecnor (plano mirando hacia -Y, hacia el robot) -->
    <geom name="deco_logo_elecnor" type="plane" pos="-0.84 1.785 0.8" euler="1.5708 0 0" size="0.72 0.24 0.02"
          material="logo_elecnor_material" contype="0" conaffinity="0"/>
    <!-- Logo departamento I+D+i -->
    <geom name="deco_logo_departamento" type="plane" pos="0.84 1.785 0.8" euler="1.5708 0 0" size="0.72 0.24 0.02"
          material="logo_departamento_material" contype="0" conaffinity="0"/>

    <!-- Peana: zócalo en el suelo, columna azul, franja naranja y tapa bajo la base -->
    <geom name="deco_peana_zocalo" type="box" pos="0 0 -0.68" size="0.24 0.24 0.02"
          material="peana_metal" contype="0" conaffinity="0"/>                                 <!-- [H] -->
    <geom name="deco_peana_columna" type="box" pos="0 0 -0.35" size="0.15 0.15 0.31"
          material="azul_personalizado" contype="0" conaffinity="0"/>                          <!-- [H] -->
