<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  INTERNAL TOOLING ONLY — customers building the SDKClient package use plain
  CMake (see README.md); this project exists purely to give the internal team
  in-IDE remote build/debug via Visual Studio's Linux tooling.

  UNVERIFIED: unlike every other file in this session, this project could not
  be build-tested here — that requires a live SSH connection registered in
  VS's Connection Manager (Tools > Options > Cross Platform > Connection
  Manager), which does not exist in this environment. The properties below
  are split into two confidence tiers (see inline comments):
    - CONFIRMED: verified against Microsoft's docs and/or the working
      SDKClient_Linux.vcxproj already in this repo.
    - BEST EFFORT: name inferred from the Windows NMake convention and a
      single confirmed sibling property (RemoteBuildCommandLine); not
      independently verified. If Rebuild/Clean/IntelliSense don't behave once
      a real connection is configured, check these first via
      Project > Properties > Configuration Properties > General/Remote Build.

  What it does when working: forwards Build/Rebuild/Clean to CMake, run on
  the remote machine over the connection selected in Connection Manager
  (matching how SDKClient_Linux itself is built — see Jenkinsfile, which spins
  up a Docker container as that remote machine in CI).
  ============================================================================
-->
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{B7E62A1C-4D53-4E8A-90F2-D1A6C3B08E48}</ProjectGuid>
    <Keyword>Linux</Keyword>
    <RootNamespace>SDKClientAppLinux</RootNamespace>
    <MinimumVisualStudioVersion>15.0</MinimumVisualStudioVersion>
    <!-- CONFIRMED: matches the working SDKClient_Linux.vcxproj in this repo. -->
    <ApplicationType>Linux</ApplicationType>
    <ApplicationTypeRevision>1.0</ApplicationTypeRevision>
    <TargetLinuxPlatform>Generic</TargetLinuxPlatform>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <!-- CONFIRMED: "Makefile" is a documented ConfigurationType choice for
         Linux projects ("to build a static or dynamic library, or to use an
         existing Makefile, use the Configuration Type setting"). -->
    <ConfigurationType>Makefile</ConfigurationType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64'" Label="Configuration">
    <!-- CONFIRMED toolset id, matches SDKClient_Linux.vcxproj. -->
    <PlatformToolset>Remote_GCC_1_0</PlatformToolset>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='ARM64'" Label="Configuration">
    <PlatformToolset>Remote_Clang_1_0</PlatformToolset>
    <RemoteCCompileToolExe>aarch64-linux-gnu-gcc</RemoteCCompileToolExe>
    <RemoteCppCompileToolExe>aarch64-linux-gnu-g++</RemoteCppCompileToolExe>
    <RemoteLdToolExe>aarch64-linux-gnu-g++</RemoteLdToolExe>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="Shared" />
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros" />

  <!--
    CONFIRMED: RemoteRootDir defaults to ~/projects; RemoteBuildProjectDir
    defaults to $(RemoteRootDir)/$(ProjectName) — left at the default here.
    CMake's build directory therefore ends up at
    ~/projects/SDKClientAppLinux/build/<Configuration>/SDKClient on the
    remote machine.
  -->
  <!--
    Explicit IntDir/OutDir, matching the exact pattern used elsewhere in this
    solution (see SDKClient_Linux.vcxproj). Fixes a real CI failure: without
    an explicit IntDir, this project's default (ProjectDir\obj\$(Platform)\
    $(Configuration)\) is never created before _CopySources tries to write
    its tracking .tlog files there, and MSBuild fails with "Could not find a
    part of the path '...\obj\x64\Release\...tlog'". The Temp\ folder under
    $(SolutionDir) is created by the solution's own build scaffolding for
    every other project, so reusing it here sidesteps the missing-directory
    problem entirely.
  -->
  <PropertyGroup>
    <OutDir>$(SolutionDir)Output\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)Temp\$(ProjectGuid)\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <PropertyGroup>
    <!-- CONFIRMED pattern (reused verbatim from SDKClient_Linux.vcxproj,
         where it is the working F5-debug launch target). -->
    <RemoteDebuggerCommand>$(RemoteRootDir)/$(ProjectName)/build/$(Configuration)/SDKClient</RemoteDebuggerCommand>
    <!--
      BEST EFFORT (name inferred from the "Remote Build Outputs" UI label and
      the confirmed "Remote" + suffix convention used by every other property
      here). For Makefile projects VS can't infer what the build produced —
      without this, Start Debugging reports "the remote output path to the
      program to debug is not set ... for makefile projects". Same absolute
      path as RemoteDebuggerCommand, since $(RemoteRootDir) already resolves
      to an absolute path at build time (confirmed in the build log).
    -->
    <RemoteOutputs>$(RemoteRootDir)/$(ProjectName)/build/$(Configuration)/SDKClient</RemoteOutputs>
  </PropertyGroup>

  <!--
    Copies the built binary back to the Windows host after a successful
    remote build, so it lands next to the other client outputs (matching
    SDKClient_Linux, whose OutDir already resolves to this same path) and
    can be picked up by the same packaging/archive step.

    BEST EFFORT: "Additional files to copy" on a Remote Post-Build Event is
    documented by Microsoft only as a UI label ("Specifies additional files
    to copy from the remote system ... using remotepath:=localpath syntax");
    AdditionalFilesToCopy is the inferred raw name. The <RemotePostBuildEvent>
    nesting itself mirrors the CONFIRMED <PreBuildEvent><Command>...</Command>
    pattern already working in SDKClient_Linux.vcxproj (elsewhere in this
    file, "Remote" + suffix properties had to be flat instead — build events
    are the one property family confirmed to accept structured children).
  -->
  <ItemDefinitionGroup>
    <RemotePostBuildEvent>
      <Message>Copying the built SDKClient binary back to the Windows host</Message>
      <AdditionalFilesToCopy>$(RemoteRootDir)/$(ProjectName)/build/$(Configuration)/SDKClient:=$(SolutionDir)Output\$(Platform)\$(Configuration)\SDKClient</AdditionalFilesToCopy>
    </RemotePostBuildEvent>
  </ItemDefinitionGroup>

  <!--
    Fixed from an earlier version of this file: RemoteBuildCommandLine and its
    siblings are simple named properties, not item metadata — they must sit
    directly in a PropertyGroup, not inside an ItemDefinitionGroup (which
    defines metadata for actual items like ClCompile/Link; this project has
    none, since the real build is entirely delegated to CMake below). Putting
    them in ItemDefinitionGroup is what produced the
    "element <#text> beneath element <RemoteBuildCommandLine> is unrecognized"
    load error.
  -->
  <PropertyGroup>
    <!--
      BEST EFFORT: sources must be copied to the remote for `cmake -S .` to
      have anything to configure. Copying is OFF by default for a Makefile
      project per Microsoft's docs; CopySources is the property that is
      documented in prose but whose raw XML name isn't published — this is
      the most likely name by convention. If Build fails with "no such file
      or directory" for CMakeLists.txt on the remote, check
      Project Properties > Copy Sources first and enable it there instead.
    -->
    <CopySources>true</CopySources>
    <!--
      BEST EFFORT names (see file header). Build is CONFIRMED
      (RemoteBuildCommandLine); Rebuild/Clean follow the same "Remote" +
      NMake-style suffix convention but are not independently verified.
      All three just forward to the CMake commands documented in README.md.
    -->
    <RemoteBuildCommandLine>cmake -S . -B build -DCMAKE_BUILD_TYPE=$(Configuration) &amp;&amp; cmake --build build --config $(Configuration)</RemoteBuildCommandLine>
    <RemoteReBuildCommandLine>cmake -S . -B build -DCMAKE_BUILD_TYPE=$(Configuration) &amp;&amp; cmake --build build --config $(Configuration) --clean-first</RemoteReBuildCommandLine>
    <RemoteCleanCommandLine>rm -rf build</RemoteCleanCommandLine>
    <!--
      BEST EFFORT: IntelliSense-only hints for a Makefile project (they do not
      affect the actual build). Raw property names not confirmed for the
      Linux Makefile project type specifically — if headers don't resolve,
      set these instead via Project Properties > C/C++ > IntelliSense once a
      real connection is configured (VS will write the correct XML for you).
    -->
    <IncludePath>$(RemoteRootDir)/$(ProjectName);$(RemoteRootDir)/$(ProjectName)/ManusSDK/include;$(RemoteRootDir)/$(ProjectName)/third_party/ftxui/include;%(IncludePath)</IncludePath>
    <PreprocessorDefinitions>%(PreprocessorDefinitions)</PreprocessorDefinitions>
  </PropertyGroup>

  <ItemGroup>
    <!--
      CONFIRMED (build-tested against a real remote): CopySources only syncs
      files that are declared as project items here — it is NOT "copy
      everything in the folder." CMakeLists.txt/README.md alone were
      confirmed to sync correctly; everything CMake actually needs
      (ManusSDK, third_party/ftxui, app/sdk/ui) must be declared too, or the
      remote build fails looking for files that were never copied.

      Recursive globs are used instead of enumerating every file (in
      particular third_party/ftxui, a vendored library with hundreds of
      files) so this list doesn't need updating as files are added. build/
      is deliberately never globbed, so local Windows build output is never
      swept into the remote copy.
    -->
    <None Include="CMakeLists.txt" />
    <None Include="README.md" />
    <None Include="cmake\**\*.*" />
    <None Include="ManusSDK\**\*.*" />
    <None Include="third_party\ftxui\**\*.*" />
    <None Include="app\**\*.*" />
    <None Include="sdk\**\*.*" />
    <None Include="ui\**\*.*" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />

  <!--
    Fixes a fresh-workspace build failure: _CopySources (the Linux remote-copy
    task) writes its .tlog bookkeeping files into $(IntDir) and assumes that
    directory already exists. For a normal (ClCompile-based) C++ project,
    Microsoft.Cpp.targets creates $(IntDir) as a side effect of preparing for
    compilation; this is a Makefile-configuration project with no ClCompile
    items, so that never happens, and $(IntDir) (defaulting to obj\$(Platform)
    \$(Configuration)\) may not exist yet — only on a workspace where nothing
    has ever built this project before. Symptom without this: "Could not find
    a part of the path '...\obj\x64\Release\...tlog'" from _CopySources.
  -->
  <Target Name="EnsureIntDirForCopySources" BeforeTargets="_CopySources">
    <MakeDir Directories="$(IntDir)" Condition="!Exists('$(IntDir)')" />
  </Target>
</Project>
